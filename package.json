{
  "name": "spore",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "SPORE — a self-propagating, censorship-resistant P2P publishing protocol that lives in a single HTML file.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@trystero-p2p/torrent": "^0.26.0",
    "lz-string": "^1.5.0",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
